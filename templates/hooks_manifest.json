{
  "version": "1.0.0",
  "description": "harness_framework hooks 12개 사용자 레포 배치 매핑",
  "files": [
    {
      "src": "hooks/tools/hooks/pre-commit",
      "dst": "tools/hooks/pre-commit",
      "executable": true,
      "on_conflict": "prompt"
    },
    {
      "src": "hooks/tools/hooks/pre-push",
      "dst": "tools/hooks/pre-push",
      "executable": true,
      "on_conflict": "prompt"
    },
    {
      "src": "hooks/tools/quality/secret-scan.sh",
      "dst": "tools/quality/secret-scan.sh",
      "executable": true,
      "on_conflict": "prompt"
    },
    {
      "src": "hooks/tools/quality/lint.sh",
      "dst": "tools/quality/lint.sh",
      "executable": true,
      "on_conflict": "prompt"
    },
    {
      "src": "hooks/tools/quality/dependency-check.sh",
      "dst": "tools/quality/dependency-check.sh",
      "executable": true,
      "on_conflict": "prompt"
    },
    {
      "src": "hooks/tools/quality/dependency_check.py",
      "dst": "tools/quality/dependency_check.py",
      "executable": false,
      "on_conflict": "prompt"
    },
    {
      "src": "hooks/tools/quality/build.sh",
      "dst": "tools/quality/build.sh",
      "executable": true,
      "on_conflict": "prompt"
    },
    {
      "src": "hooks/tools/quality/test.sh",
      "dst": "tools/quality/test.sh",
      "executable": true,
      "on_conflict": "prompt"
    },
    {
      "src": "hooks/tools/install-hooks.sh",
      "dst": "tools/install-hooks.sh",
      "executable": true,
      "on_conflict": "prompt"
    },
    {
      "src": "hooks/ruff.toml",
      "dst": "ruff.toml",
      "executable": false,
      "on_conflict": "prompt"
    },
    {
      "src": "hooks/requirements-dev.txt",
      "dst": "requirements-dev.txt",
      "executable": false,
      "on_conflict": "prompt"
    },
    {
      "src": "hooks/.gitattributes-fragment",
      "dst": ".gitattributes",
      "executable": false,
      "on_conflict": "append_fragment",
      "fragment_marker": "# harness_framework hooks"
    }
  ],
  "post_install": [
    {
      "type": "git_config",
      "key": "core.hooksPath",
      "value": "tools/hooks",
      "scope": "local",
      "on_conflict": "prompt"
    }
  ],
  "rollback": {
    "remove_files": true,
    "restore_backups": true,
    "unset_git_config": ["core.hooksPath"]
  },
  "prerequisites_check": {
    "required": ["git", "bash"],
    "recommended": ["dotnet", "python", "gitleaks", "ruff", "pytest"]
  }
}
