#!/usr/bin/env bash
# tools/hooks/pre-push — 전체 검사 (워킹트리 기준)
# 호출: git push (stdin: <local-ref> <local-sha> <remote-ref> <remote-sha> — 무시)
# 정책:
#   - secret/lint/dependency-check/build 단계는 어떤 환경 변수로도 스킵 불가
#   - test 단계만 HOOKS_SKIP_TESTS=1로 가시화하여 스킵 (PR에 사유 기록 의무)
#   - --no-verify는 긴급 hotfix 전용 — 다음 PR 본문에 사유 기록 의무

set -euo pipefail
IFS=$'\n\t'

if [[ "${HOOKS_DEBUG:-}" == "1" ]]; then set -x; fi

# stdin은 git이 ref 정보를 보내지만, 워킹트리 기준 단순화로 소비만 하고 무시
if [[ ! -t 0 ]]; then
    cat >/dev/null || true
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
QDIR="tools/quality"

run_step() {
    local name="$1"; shift
    echo "→ $name" >&2
    "$@"
}

run_step "secret-scan --all"       "$QDIR/secret-scan.sh"      --all
run_step "lint --all"              "$QDIR/lint.sh"             --all
run_step "dependency-check --all"  "$QDIR/dependency-check.sh" --all
run_step "build --all"             "$QDIR/build.sh"            --all
run_step "test --all"              "$QDIR/test.sh"             --all

exit 0
