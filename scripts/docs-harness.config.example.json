{
  "_comment": "Place this file at <target-repo>/.claude/docs-harness.config.json. Remove _comment fields. Single-project: 1 entry in services. Multi-service: N entries.",
  "services": [
    {
      "name": "Master",
      "code": "MASTER",
      "docs_dir": "Docs/Master",
      "app_dir": "Src/MyApp/App/Master"
    },
    {
      "name": "ApiGateway",
      "code": "APIGATEWAY",
      "docs_dir": "Docs/ApiGateway",
      "app_dir": "Src/MyApp/App/APIGateway"
    }
  ],
  "repo_required_files": ["CLAUDE.md"],
  "repo_required_dirs": ["Docs"],
  "protected_subpaths": ["Docs", "Src", ".git", "scripts"],
  "excluded_docs_dirs": ["Docs/Client", "Docs/Policy"]
}
